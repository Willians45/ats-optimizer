# === Configuración del servidor (Vercel / dev local) ===
# IMPORTANTE: nunca uses el prefijo VITE_ para esta variable.
# Las variables VITE_ se incrustan en el bundle público y cualquiera puede leerlas.
GEMINI_API_KEY=tu_api_key_de_gemini_aqui

# Modelo por defecto. Opciones permitidas:
# gemini-3.8-flash | gemini-4-hydrogen | gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.8-flash
